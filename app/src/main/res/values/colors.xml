    <color name="primary">#FF3677EF</color>
    <color name="primary_dark">#FF2A5FD0</color>
    <color name="primary_light">#FF5B9BFF</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 启动窗口底色：用纯白，与 Compose 启动页顶部的 #FFFFFF 无缝衔接。
