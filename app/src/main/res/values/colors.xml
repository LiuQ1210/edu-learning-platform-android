<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      只保留「XML 侧真正用到」的颜色。
      品牌色（primary/primary_dark/primary_light）和黑色已经全部迁到 Compose 的
      ui/theme/Color.kt，这里不再重复定义，避免两处色值漂移。
    -->
    <color name="white">#FFFFFFFF</color>

    <!-- 启动窗口底色：用纯白，与 Compose 启动页顶部的 #FFFFFF 无缝衔接。
         不要用品牌蓝 —— 那会造成「蓝底闪一下再变奶油底」的跳色。 -->
    <color name="splash_background">#FFFFFFFF</color>

    <!-- 状态栏 / 导航栏透明交给 enableEdgeToEdge()，这里只留占位 -->
    <color name="transparent">#00000000</color>
</resources>
